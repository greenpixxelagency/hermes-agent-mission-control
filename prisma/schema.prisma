generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

enum ProjectRole {
  OWNER
  ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ThreadStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNMENT_CHANGED
  DUE_DATE_CHANGED
  COMPLETED
  RUNTIME_QUEUED
  RUNTIME_STARTED
  RUNTIME_SUCCEEDED
  RUNTIME_FAILED
}

enum HermesRuntimeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum HermesRuntimeKind {
  HERMES_PROFILE
  HERMES_BOT
}

enum HermesProvisioningState {
  UNPROVISIONED
  PROVISIONING
  READY
  FAILED
}

enum HermesReconciliationState {
  IN_SYNC
  DRIFTED
  SYNCING
  FAILED
}

enum HermesRuntimeAssignmentState {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum SkillTrustStatus {
  TRUSTED
  UNTRUSTED
}

enum EmployeeSkillAssignmentState {
  ACTIVE
  REMOVED
}

enum HermesExecutionStatus {
  QUEUED
  DISPATCHING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum HermesExecutionReviewStatus {
  PENDING
  ACCEPTED
  REVISION_REQUESTED
}

enum EmployeeType {
  SYSTEM
  CUSTOM
}

enum EmployeeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BrainSourceType {
  HUMAN
  THREAD
  TASK
  HERMES
  MNEMOSYNE
  FILE
  INTEGRATION
  SYSTEM
}

enum BrainRecordStatus {
  ACTIVE
  ARCHIVED
}

enum MemoryType {
  FACT
  PREFERENCE
  LESSON
  EXPERIENCE
  ENTITY
  OBSERVATION
}

enum SOPStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PolicyEnforcement {
  ADVISORY
  REQUIRE_APPROVAL
  BLOCK
}

enum PolicyType {
  ACTION
  SPEND
  PUBLISHING
  DATA_ACCESS
  COMMUNICATION
  CUSTOM
}

enum ProjectToolStatus {
  AVAILABLE
  CONNECTED
  DISCONNECTED
  DISABLED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  NEEDS_ATTENTION
  DISABLED
}

// M13: credential material is encrypted server-side. A connection never owns
// plaintext OAuth tokens and these states are safe to render to project users.
enum ConnectionCredentialStatus {
  ACTIVE
  NEEDS_ATTENTION
  REVOKED
}

enum DriveScopeType {
  FOLDER
  FILE
}

enum DriveSourceStatus {
  PENDING
  READY
  UNSUPPORTED
  ERROR
}

enum ToolExecutionStatus {
  REQUESTED
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PermissionLevel {
  NO_ACCESS
  READ
  DRAFT
  EXECUTE_WITH_APPROVAL
  FULL_EXECUTE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AuditActorType {
  HUMAN
  EMPLOYEE
  SYSTEM
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String?                   @unique
  emailVerified            DateTime?
  image                    String?
  accounts                 Account[]
  sessions                 Session[]
  organizationMemberships  OrganizationMember[]
  createdConversations     Conversation[]            @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  messages                 Message[]                 @relation("MessageAuthor")
  taskActivities           TaskActivity[]            @relation("TaskActivityActor")
  brainSources             KnowledgeSource[]
  knowledgeItems           KnowledgeItem[]
  decisions                Decision[]
  credential               UserCredential?
  passwordResetTokens      PasswordResetToken[]
  driveOAuthStates         DriveOAuthState[]
  assignedEmployeeSkills   EmployeeSkillAssignment[] @relation("SkillAssignedBy")
}

model UserCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  status    OrganizationStatus   @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  projects  Project[]
}

model OrganizationMember {
  id                 String           @id @default(cuid())
  userId             String
  organizationId     String
  role               OrganizationRole @default(VIEWER)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMember[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model Project {
  id                       String                      @id @default(cuid())
  organizationId           String
  name                     String
  slug                     String
  status                   ProjectStatus               @default(ACTIVE)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                  ProjectMember[]
  agentRequests            AgentRequest[]
  agentEvents              AgentEvent[]
  hermesTasks              HermesTask[]
  hermesMemories           HermesMemory[]
  dataStoreEntries         ProjectDataStore[]
  conversations            Conversation[]
  messages                 Message[]
  threads                  Thread[]
  tasks                    Task[]
  employeeAssignments      EmployeeProjectAssignment[]
  constitution             ProjectConstitution?
  knowledgeItems           KnowledgeItem[]
  decisions                Decision[]
  memories                 ProjectMemory[]
  knowledgeSources         KnowledgeSource[]
  sops                     SOP[]
  policies                 Policy[]
  taskSops                 TaskSOP[]
  tools                    ProjectTool[]
  connections              ProjectConnection[]
  toolExecutions           ToolExecution[]
  approvalRequests         ApprovalRequest[]
  auditEvents              AuditEvent[]
  hermesRuntimeAssignments HermesRuntimeAssignment[]
  hermesExecutions         HermesExecution[]
  connectionCredentials    ConnectionCredential[]
  connectionScopes         ProjectConnectionScope[]
  driveSources             DriveSource[]
  driveOAuthStates         DriveOAuthState[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ToolDefinition {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  description  String?
  category     String           @default("GENERAL")
  builtIn      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  capabilities ToolCapability[]
  projectTools ProjectTool[]
}

model ToolCapability {
  id               String         @id @default(cuid())
  toolDefinitionId String
  key              String
  name             String
  description      String?
  tool             ToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)

  @@unique([toolDefinitionId, key])
}

model ProjectTool {
  id               String                   @id @default(cuid())
  projectId        String
  toolDefinitionId String
  displayName      String?
  status           ProjectToolStatus        @default(DISCONNECTED)
  credentialRef    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool             ToolDefinition           @relation(fields: [toolDefinitionId], references: [id], onDelete: Restrict)
  permissions      EmployeeToolPermission[]
  approvalRequests ApprovalRequest[]
  auditEvents      AuditEvent[]
  connections      ProjectConnection[]
  executions       ToolExecution[]

  @@unique([projectId, toolDefinitionId])
  @@unique([id, projectId])
  @@index([projectId, status])
}

// M12: a project-owned connection references a server-side credential handle
// only. It never persists the credential value or exposes it to a client.
model ProjectConnection {
  id            String                   @id @default(cuid())
  projectId     String
  projectToolId String
  name          String
  status        ConnectionStatus         @default(DISCONNECTED)
  enabled       Boolean                  @default(true)
  credentialRef String?
  metadata      Json                     @default("{}")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTool   ProjectTool              @relation(fields: [projectToolId, projectId], references: [id, projectId], onDelete: Restrict)
  executions    ToolExecution[]
  credential    ConnectionCredential?
  scopes        ProjectConnectionScope[]
  driveSources  DriveSource[]

  @@unique([projectId, projectToolId])
  @@unique([id, projectId])
  @@index([projectId, status])
}

// Credential payloads contain an authenticated-encryption envelope only.
// The encryption key is environment-only and never stored in PostgreSQL.
model ConnectionCredential {
  id                 String                     @id @default(cuid())
  projectId          String
  connectionId       String                     @unique
  provider           String
  encryptedPayload   String                     @db.Text
  keyVersion         String                     @default("v1")
  expiresAt          DateTime?
  status             ConnectionCredentialStatus @default(ACTIVE)
  accountEmail       String?
  accountDisplayName String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection         ProjectConnection          @relation(fields: [connectionId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([id, projectId])
  @@unique([connectionId, projectId])
  @@index([projectId, status])
}

// A connected account is not blanket authorization. Every external object
// used by RogerOS must be deliberately selected into this project-owned list.
model ProjectConnectionScope {
  id               String            @id @default(cuid())
  projectId        String
  connectionId     String
  type             DriveScopeType
  externalId       String
  displayName      String
  parentExternalId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection       ProjectConnection @relation(fields: [connectionId, projectId], references: [id, projectId], onDelete: Restrict)
  driveSources     DriveSource[]

  @@unique([connectionId, type, externalId])
  @@unique([id, projectId])
  @@index([projectId, connectionId, type])
}

// One-time database-backed state protects the Drive OAuth callback from CSRF,
// cross-project substitution, and replay. Only a SHA-256 digest is persisted.
model DriveOAuthState {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId, expiresAt])
}

// M12: ToolExecution records governed capability work. HermesExecution remains
// the runtime record and can never substitute for this authorization boundary.
model ToolExecution {
  id                          String                    @id @default(cuid())
  projectId                   String
  employeeProjectAssignmentId String
  projectToolId               String
  projectConnectionId         String
  approvalRequestId           String?
  capabilityKey               String
  actionKey                   String
  requestFingerprint          String
  status                      ToolExecutionStatus       @default(REQUESTED)
  requestMetadata             Json                      @default("{}")
  resultMetadata              Json                      @default("{}")
  resultText                  String?                   @db.Text
  errorMessage                String?                   @db.Text
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  project                     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeAssignment          EmployeeProjectAssignment @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Restrict)
  projectTool                 ProjectTool               @relation(fields: [projectToolId, projectId], references: [id, projectId], onDelete: Restrict)
  connection                  ProjectConnection         @relation(fields: [projectConnectionId, projectId], references: [id, projectId], onDelete: Restrict)
  approvalRequest             ApprovalRequest?          @relation(fields: [approvalRequestId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([id, projectId])
  @@index([projectId, status, createdAt])
  @@index([projectId, employeeProjectAssignmentId, createdAt])
  @@index([projectId, approvalRequestId])
}

model EmployeeToolPermission {
  id                          String                    @id @default(cuid())
  projectId                   String
  employeeProjectAssignmentId String
  projectToolId               String
  level                       PermissionLevel           @default(NO_ACCESS)
  capabilityKey               String                    @default("*")
  grantedById                 String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  employeeAssignment          EmployeeProjectAssignment @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)
  projectTool                 ProjectTool               @relation(fields: [projectToolId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([employeeProjectAssignmentId, projectToolId, capabilityKey])
  @@index([projectId, projectToolId])
}

// Governance records are always anchored to a Project. Optional provenance
// relations deliberately use Restrict: projectId remains required, so SetNull
// would make a composite foreign key invalid and weaken project ownership.
model ApprovalRequest {
  id                              String                     @id @default(cuid())
  projectId                       String
  status                          ApprovalStatus             @default(PENDING)
  requestedByEmployeeAssignmentId String?
  requestedByProjectMemberId      String?
  taskId                          String?
  threadId                        String?
  projectToolId                   String
  capabilityKey                   String                     @default("*")
  actionKey                       String
  summary                         String
  actionContext                   Json
  authorizationSnapshot           Json
  policySnapshot                  Json
  permissionLevel                 PermissionLevel?
  requestedAt                     DateTime                   @default(now())
  expiresAt                       DateTime?
  decidedAt                       DateTime?
  decidedByProjectMemberId        String?
  decisionNote                    String?                    @db.Text
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  project                         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedByEmployee             EmployeeProjectAssignment? @relation(fields: [requestedByEmployeeAssignmentId, projectId], references: [id, projectId], onDelete: Restrict)
  requestedByMember               ProjectMember?             @relation("ApprovalRequester", fields: [requestedByProjectMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  task                            Task?                      @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  thread                          Thread?                    @relation(fields: [threadId, projectId], references: [id, projectId], onDelete: Restrict)
  projectTool                     ProjectTool                @relation(fields: [projectToolId, projectId], references: [id, projectId], onDelete: Restrict)
  decidedBy                       ProjectMember?             @relation("ApprovalDecider", fields: [decidedByProjectMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  auditEvents                     AuditEvent[]
  toolExecutions                  ToolExecution[]

  @@unique([id, projectId])
  @@index([projectId, status, requestedAt])
  @@index([projectId, projectToolId])
}

model AuditEvent {
  id                        String                     @id @default(cuid())
  projectId                 String
  eventType                 String
  actorType                 AuditActorType
  actorProjectMemberId      String?
  actorEmployeeAssignmentId String?
  targetType                String
  targetId                  String?
  taskId                    String?
  approvalRequestId         String?
  projectToolId             String?
  summary                   String
  metadata                  Json
  createdAt                 DateTime                   @default(now())
  project                   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorProjectMember        ProjectMember?             @relation(fields: [actorProjectMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  actorEmployeeAssignment   EmployeeProjectAssignment? @relation(fields: [actorEmployeeAssignmentId, projectId], references: [id, projectId], onDelete: Restrict)
  task                      Task?                      @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  approvalRequest           ApprovalRequest?           @relation(fields: [approvalRequestId, projectId], references: [id, projectId], onDelete: Restrict)
  projectTool               ProjectTool?               @relation(fields: [projectToolId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, eventType, createdAt])
}

model SOP {
  id              String       @id @default(cuid())
  projectId       String
  title           String
  description     String?      @db.Text
  category        String       @default("GENERAL")
  tags            String[]     @default([])
  appliesToRole   String?
  status          SOPStatus    @default(DRAFT)
  activeVersionId String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        SOPVersion[] @relation("SOPVersions")
  activeVersion   SOPVersion?  @relation("ActiveSOPVersion", fields: [activeVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  taskLinks       TaskSOP[]

  @@unique([id, projectId])
  @@index([projectId, status, updatedAt])
}

model SOPVersion {
  id            String   @id @default(cuid())
  sopId         String
  projectId     String
  version       Int
  content       String   @db.Text
  changeSummary String?
  createdById   String?
  createdAt     DateTime @default(now())
  sop           SOP      @relation("SOPVersions", fields: [sopId, projectId], references: [id, projectId], onDelete: Cascade)
  activeFor     SOP[]    @relation("ActiveSOPVersion")

  @@unique([sopId, version])
  @@unique([id, projectId])
}

model Policy {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String            @db.Text
  type        PolicyType        @default(CUSTOM)
  status      PolicyStatus      @default(DRAFT)
  enforcement PolicyEnforcement @default(ADVISORY)
  rule        Json
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, type])
}

model TaskSOP {
  id        String   @id @default(cuid())
  projectId String
  taskId    String
  sopId     String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  sop       SOP      @relation(fields: [sopId, projectId], references: [id, projectId], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([taskId, sopId])
  @@index([projectId, sopId])
}

model KnowledgeSource {
  id             String          @id @default(cuid())
  projectId      String
  type           BrainSourceType
  label          String
  reference      String?
  occurredAt     DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  knowledgeItems KnowledgeItem[]
  decisions      Decision[]
  memories       ProjectMemory[]
  driveSource    DriveSource?

  @@unique([id, projectId])
  @@index([projectId, type, createdAt])
}

// Drive remains the source of truth. RogerOS retains only bounded selected
// content plus safe provenance for searchable project context.
model DriveSource {
  id                String                  @id @default(cuid())
  projectId         String
  connectionId      String
  scopeId           String?
  knowledgeSourceId String                  @unique
  externalFileId    String
  parentExternalId  String?
  name              String
  mimeType          String
  webUrl            String?
  modifiedAt        DateTime?
  contentPreview    String?                 @db.Text
  contentHash       String?
  status            DriveSourceStatus       @default(PENDING)
  lastFetchedAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection        ProjectConnection       @relation(fields: [connectionId, projectId], references: [id, projectId], onDelete: Restrict)
  scope             ProjectConnectionScope? @relation(fields: [scopeId, projectId], references: [id, projectId], onDelete: Restrict)
  knowledgeSource   KnowledgeSource         @relation(fields: [knowledgeSourceId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, connectionId, externalFileId])
  @@unique([id, projectId])
  @@unique([knowledgeSourceId, projectId])
  @@index([projectId, status, updatedAt])
  @@index([projectId, connectionId])
}

model ProjectConstitution {
  id        String            @id @default(cuid())
  projectId String            @unique
  title     String            @default("Project Constitution")
  content   String            @db.Text
  status    BrainRecordStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KnowledgeItem {
  id          String            @id @default(cuid())
  projectId   String
  sourceId    String?
  title       String
  content     String            @db.Text
  category    String            @default("GENERAL")
  status      BrainRecordStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      KnowledgeSource?  @relation(fields: [sourceId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, status, updatedAt])
}

model Decision {
  id          String            @id @default(cuid())
  projectId   String
  sourceId    String?
  title       String
  decision    String            @db.Text
  rationale   String?           @db.Text
  status      BrainRecordStatus @default(ACTIVE)
  decidedAt   DateTime          @default(now())
  decidedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      KnowledgeSource?  @relation(fields: [sourceId, projectId], references: [id, projectId], onDelete: Restrict)
  decidedBy   User?             @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, decidedAt])
}

model ProjectMemory {
  id         String            @id @default(cuid())
  projectId  String
  sourceId   String?
  title      String
  content    String            @db.Text
  type       MemoryType        @default(FACT)
  confidence String?
  importance Int               @default(3)
  status     BrainRecordStatus @default(ACTIVE)
  learnedAt  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     KnowledgeSource?  @relation(fields: [sourceId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([projectId, type, status, updatedAt])
}

model ProjectMember {
  id                   String             @id @default(cuid())
  projectId            String
  organizationMemberId String
  organizationId       String
  role                 ProjectRole        @default(VIEWER)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  project              Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskAssignments      TaskAssignment[]
  requestedApprovals   ApprovalRequest[]  @relation("ApprovalRequester")
  decidedApprovals     ApprovalRequest[]  @relation("ApprovalDecider")
  reviewedExecutions   HermesExecution[]  @relation("HermesExecutionReviewer")
  auditEvents          AuditEvent[]

  @@unique([projectId, organizationMemberId])
  @@unique([id, projectId])
  @@index([organizationId])
  @@index([organizationMemberId])
}

// ─── RogerOS Team ──────────────────────────────────────────────

// A conversation is explicitly project-owned. The composite id/project key
// lets child records enforce that they cannot point at another project's row.
model Conversation {
  id           String                    @id @default(cuid())
  projectId    String
  type         ConversationType
  slug         String?
  title        String?
  createdById  String?
  archivedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  threads      Thread[]

  @@unique([id, projectId])
  @@unique([projectId, slug])
  @@index([projectId, type, updatedAt])
}

// Human participants use userId. systemIdentity is a deliberately small,
// migratable bridge for M6 system employees (for example chief-of-staff).
model ConversationParticipant {
  id                          String                     @id @default(cuid())
  projectId                   String
  conversationId              String
  userId                      String?
  systemIdentity              String?
  employeeProjectAssignmentId String?
  createdAt                   DateTime                   @default(now())
  conversation                Conversation               @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  user                        User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeProjectAssignment   EmployeeProjectAssignment? @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, systemIdentity])
  @@index([projectId, userId])
  @@index([projectId, employeeProjectAssignmentId])
}

model Message {
  id                   String       @id @default(cuid())
  projectId            String
  conversationId       String
  threadId             String?
  authorUserId         String?
  authorSystemIdentity String?
  body                 String       @db.Text
  kind                 String       @default("MESSAGE")
  editedAt             DateTime?
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation         Conversation @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  author               User?        @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  thread               Thread?      @relation("ThreadReplies", fields: [threadId, projectId], references: [id, projectId], onDelete: Cascade)
  rootForThread        Thread?      @relation("ThreadRootMessage")

  @@unique([id, projectId, conversationId])
  @@index([projectId, conversationId, createdAt])
  @@index([projectId, threadId, createdAt])
}

model Thread {
  id               String            @id @default(cuid())
  projectId        String
  conversationId   String
  rootMessageId    String
  title            String?
  status           ThreadStatus      @default(OPEN)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation     Conversation      @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  rootMessage      Message           @relation("ThreadRootMessage", fields: [rootMessageId, projectId, conversationId], references: [id, projectId, conversationId], onDelete: Restrict)
  replies          Message[]         @relation("ThreadReplies")
  relatedTasks     Task[]            @relation("TaskThread")
  approvalRequests ApprovalRequest[]

  @@unique([id, projectId])
  @@unique([projectId, rootMessageId])
  @@unique([rootMessageId, projectId, conversationId])
  @@index([projectId, conversationId, status])
}

// ─── RogerOS Tasks 2.0 ─────────────────────────────────────────

// Task is the authoritative RogerOS work record. HermesTask remains a
// separate execution adapter and is deliberately not used as this model.
model Task {
  id               String            @id @default(cuid())
  projectId        String
  parentTaskId     String?
  relatedThreadId  String?
  title            String
  description      String?           @db.Text
  status           TaskStatus        @default(TODO)
  priority         TaskPriority      @default(MEDIUM)
  createdById      String
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  resultSummary    String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask       Task?             @relation("TaskHierarchy", fields: [parentTaskId, projectId], references: [id, projectId], onDelete: Restrict)
  subtasks         Task[]            @relation("TaskHierarchy")
  relatedThread    Thread?           @relation("TaskThread", fields: [relatedThreadId, projectId], references: [id, projectId], onDelete: Restrict)
  assignments      TaskAssignment[]
  activities       TaskActivity[]
  dependencies     TaskDependency[]  @relation("TaskDependencies")
  dependedOnBy     TaskDependency[]  @relation("TaskDependents")
  sopLinks         TaskSOP[]
  approvalRequests ApprovalRequest[]
  auditEvents      AuditEvent[]
  hermesExecutions HermesExecution[]

  @@unique([id, projectId])
  @@index([projectId, status, updatedAt])
  @@index([projectId, parentTaskId])
}

// A human assignee is anchored to ProjectMember, ensuring the user is already
// authorized for this project. systemIdentity is the small M6-migratable path
// for future system/employee assignment.
model TaskAssignment {
  id                          String                     @id @default(cuid())
  projectId                   String
  taskId                      String
  projectMemberId             String?
  systemIdentity              String?
  employeeProjectAssignmentId String?
  createdAt                   DateTime                   @default(now())
  task                        Task                       @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember               ProjectMember?             @relation(fields: [projectMemberId, projectId], references: [id, projectId], onDelete: Cascade)
  employeeProjectAssignment   EmployeeProjectAssignment? @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([taskId, projectMemberId])
  @@unique([taskId, systemIdentity])
  @@unique([taskId, employeeProjectAssignmentId])
  @@index([projectId, projectMemberId])
  @@index([projectId, employeeProjectAssignmentId])
}

model Employee {
  id                 String                      @id @default(cuid())
  systemKey          String?                     @unique
  name               String
  role               String
  description        String?                     @db.Text
  soulSummary        String?                     @db.Text
  type               EmployeeType                @default(CUSTOM)
  status             EmployeeStatus              @default(ACTIVE)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  projectAssignments EmployeeProjectAssignment[]
}

model EmployeeProjectAssignment {
  id                       String                    @id @default(cuid())
  employeeId               String
  projectId                String
  status                   EmployeeStatus            @default(ACTIVE)
  roleOverride             String?
  joinedAt                 DateTime                  @default(now())
  pausedAt                 DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  employee                 Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationParticipants ConversationParticipant[]
  taskAssignments          TaskAssignment[]
  toolPermissions          EmployeeToolPermission[]
  runtimeAssignments       HermesRuntimeAssignment[]
  approvalRequests         ApprovalRequest[]
  auditEvents              AuditEvent[]
  toolExecutions           ToolExecution[]
  skillAssignments         EmployeeSkillAssignment[]

  @@unique([employeeId, projectId])
  @@unique([id, projectId])
  @@index([projectId, status])
}

// M15: RogerOS owns the trusted catalog; Hermes receives only this managed overlay.
model Skill {
  id               String                    @id @default(cuid())
  slug             String                    @unique
  name             String
  description      String                    @db.Text
  category         String
  sourceType       String                    @default("SYSTEM")
  sourceIdentifier String                    @unique
  version          String                    @default("1.0.0")
  trustStatus      SkillTrustStatus          @default(TRUSTED)
  isEnabled        Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  assignments      EmployeeSkillAssignment[]
}

model EmployeeSkillAssignment {
  id                          String                       @id @default(cuid())
  projectId                   String
  employeeProjectAssignmentId String
  skillId                     String
  state                       EmployeeSkillAssignmentState @default(ACTIVE)
  assignedByUserId            String?
  desiredVersion              String
  assignedAt                  DateTime                     @default(now())
  removedAt                   DateTime?
  lastReconciledAt            DateTime?
  reconciliationStatus        HermesReconciliationState    @default(DRIFTED)
  reconciliationError         String?                      @db.Text
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  employeeProjectAssignment   EmployeeProjectAssignment    @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)
  skill                       Skill                        @relation(fields: [skillId], references: [id], onDelete: Restrict)
  assignedBy                  User?                        @relation("SkillAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeProjectAssignmentId, skillId])
  @@index([projectId, state])
  @@index([skillId, state])
}

// M11: Hermes is an execution runtime only. Project-scoped assignments keep
// RogerOS tenancy and task ownership authoritative.
model HermesRuntime {
  id          String                    @id @default(cuid())
  key         String                    @unique
  name        String
  status      HermesRuntimeStatus       @default(ACTIVE)
  endpoint    String?
  profileKey  String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  assignments HermesRuntimeAssignment[]
  executions  HermesExecution[]
}

model HermesRuntimeAssignment {
  id                          String                       @id @default(cuid())
  projectId                   String
  runtimeId                   String
  employeeProjectAssignmentId String?
  profileKey                  String
  active                      Boolean                      @default(true)
  runtimeKind                 HermesRuntimeKind            @default(HERMES_PROFILE)
  assignmentState             HermesRuntimeAssignmentState @default(ACTIVE)
  provisioningState           HermesProvisioningState      @default(UNPROVISIONED)
  reconciliationState         HermesReconciliationState    @default(DRIFTED)
  desiredDisplayName          String?
  desiredDescription          String?                      @db.Text
  desiredSoulRevision         Int                          @default(1)
  desiredSoulHash             String?
  desiredModelProvider        String?
  desiredModelId              String?
  desiredSkillRevision        Int                          @default(0)
  desiredRoutineRevision      Int                          @default(0)
  lastObservedHermesVersion   String?
  capabilityFingerprint       String?
  lastReconciledAt            DateTime?
  lastReconcileError          String?                      @db.Text
  runtimeStatus               String?
  suspendedAt                 DateTime?
  retiredAt                   DateTime?
  externalRuntimeMetadata     Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  project                     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runtime                     HermesRuntime                @relation(fields: [runtimeId], references: [id], onDelete: Restrict)
  employeeAssignment          EmployeeProjectAssignment?   @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Restrict)
  executions                  HermesExecution[]

  @@unique([projectId, employeeProjectAssignmentId])
  @@unique([projectId, profileKey])
  @@unique([id, projectId])
  @@index([projectId, active])
}

model HermesExecution {
  id                        String                       @id @default(cuid())
  projectId                 String
  taskId                    String
  runtimeId                 String
  runtimeAssignmentId       String
  status                    HermesExecutionStatus        @default(QUEUED)
  // Adapter execution IDs are authoritative only for lifecycle synchronization.
  // They never grant a runtime or tool permission.
  externalExecutionId       String?                      @unique
  prompt                    String                       @db.Text
  resultText                String?                      @db.Text
  errorMessage              String?                      @db.Text
  reviewStatus              HermesExecutionReviewStatus?
  reviewedByProjectMemberId String?
  reviewedAt                DateTime?
  reviewNote                String?                      @db.Text
  callbackReceivedAt        DateTime?
  callbackFingerprint       String?
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  project                   Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                      Task                         @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  runtime                   HermesRuntime                @relation(fields: [runtimeId], references: [id], onDelete: Restrict)
  runtimeAssignment         HermesRuntimeAssignment      @relation(fields: [runtimeAssignmentId, projectId], references: [id, projectId], onDelete: Restrict)
  reviewedBy                ProjectMember?               @relation("HermesExecutionReviewer", fields: [reviewedByProjectMemberId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([projectId, status, createdAt])
  @@index([projectId, taskId, createdAt])
  @@index([taskId, status])
  @@index([projectId, reviewStatus, completedAt])
}

model TaskDependency {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskDependencies", fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependents", fields: [dependsOnTaskId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([projectId, dependsOnTaskId])
}

model TaskActivity {
  id          String           @id @default(cuid())
  projectId   String
  taskId      String
  actorUserId String?
  type        TaskActivityType
  detail      String?          @db.Text
  createdAt   DateTime         @default(now())
  task        Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  actor       User?            @relation("TaskActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, taskId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?

  // Content intelligence fields
  source          String? // "sage" | "organic" | "csv_import"
  engagementScore Float? // time-weighted composite score (updated by scoring engine)
  engagementTier  String? // "top20" | "bottom20" | null (cleared/set on rescore)

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json
}

model YoutubeIdea {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  angle            String?
  hookType         String?
  funnelStage      String?
  status           String   @default("pending")
  rejectedReason   String?
  sourceUrl        String?
  sourceSummary    String?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime @default(now())

  @@index([status])
}

model YoutubeScript {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  storySetup       String?
  conflict         String?
  insight          String?
  cta              String?
  caption          String?
  onScreenText     String?
  hookType         String?
  funnelStage      String?
  factCheck        Json?
  fullScript       String?
  status           String   @default("draft")
  rejectedReason   String?
  // SEO Package
  seoTitle         String?
  seoDescription   String?
  seoTags          Json?
  seoChapters      Json?
  titleVariants    Json?
  thumbnailConcept String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())
}

model LongformScript {
  id               String    @id @default(cuid())
  title            String
  type             String?
  status           String    @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Project-owned replacement for the legacy global DataStore. Legacy callers
// remain on DataStore until their respective isolation milestone.
model ProjectDataStore {
  id        String   @id @default(cuid())
  projectId String
  namespace String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, namespace, key])
  @@index([projectId, namespace])
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String    @db.Text
  status      String    @default("pending") // pending, active, completed, failed
  priority    String    @default("medium") // high, medium, low
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// ─── Articles ───────────────────────────────────────────────────

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String    @db.Text
  track           String // "mega-viral" | "local-viral" | "icp-viral"
  status          String    @default("idea") // "idea" | "draft" | "ready" | "posted"
  qtTweet         String?   @db.Text
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?   @db.Text
  inspirationUrls String?   @db.Text // JSON array of URLs
  themes          String? // JSON array of themes
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String? // JSON array
  createdAt DateTime @default(now())

  @@index([track])
}

// ─── Client Pulse Telegram Bot ─────────────────────────────────

model ClientPulseClient {
  id                   String                @id @default(cuid())
  notionPageId         String?               @unique
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                ClientPulseChat[]
  analyses             ClientPulseAnalysis[]
  alerts               ClientPulseAlert[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  messages        ClientPulseMessage[]
  alerts          ClientPulseAlert[]

  @@index([linkedClientId])
  @@index([status])
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String           @db.Text
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?           @db.Text
  llmSummary          String?           @db.Text
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String             @db.Text
  recommendedAction String?            @db.Text
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  client            ClientPulseClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String       @id @default(cuid())
  projectId     String
  origin        String       @default("web") // "web" | "hermes"
  kind          String       @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  sideEffecting Boolean      @default(false)
  status        String       @default("queued") // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events        AgentEvent[]

  @@index([projectId, status])
  @@index([createdAt])
}

model AgentEvent {
  id             String        @id @default(cuid())
  projectId      String
  agentRequestId String?
  kind           String        @default("activity") // activity | run | status | memory
  title          String
  detail         String?
  agent          String?
  level          String        @default("info") // info | up | warn | down
  meta           Json?
  createdAt      DateTime      @default(now())
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRequest   AgentRequest? @relation(fields: [agentRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([agentRequestId])
}

model HermesTask {
  id        String // Hermes external task id
  projectId String
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, board])
  @@index([projectId, status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String // wiki entry slug (relative path w/o .md)
  projectId  String
  namespace  String    @default("default")
  source     String    @default("hermes-wiki")
  path       String // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, namespace, type])
  @@index([projectId, status])
}
