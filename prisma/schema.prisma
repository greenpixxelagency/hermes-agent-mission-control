generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

enum ProjectRole {
  OWNER
  ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ThreadStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNMENT_CHANGED
  DUE_DATE_CHANGED
  COMPLETED
}
enum EmployeeType {
  SYSTEM
  CUSTOM
}
enum EmployeeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String?              @unique
  emailVerified           DateTime?
  image                   String?
  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  createdConversations    Conversation[]         @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  messages                Message[]              @relation("MessageAuthor")
  taskActivities          TaskActivity[]         @relation("TaskActivityActor")
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  status    OrganizationStatus   @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  projects  Project[]
}

model OrganizationMember {
  id                 String           @id @default(cuid())
  userId             String
  organizationId     String
  role               OrganizationRole @default(VIEWER)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMember[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model Project {
  id               String             @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  status           ProjectStatus      @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  agentRequests    AgentRequest[]
  agentEvents      AgentEvent[]
  hermesTasks      HermesTask[]
  hermesMemories   HermesMemory[]
  dataStoreEntries ProjectDataStore[]
  conversations    Conversation[]
  messages         Message[]
  threads          Thread[]
  tasks            Task[]
  employeeAssignments EmployeeProjectAssignment[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ProjectMember {
  id                   String             @id @default(cuid())
  projectId            String
  organizationMemberId String
  organizationId       String
  role                 ProjectRole        @default(VIEWER)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  project              Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskAssignments      TaskAssignment[]

  @@unique([projectId, organizationMemberId])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@unique([id, projectId])
}

// ─── RogerOS Team ──────────────────────────────────────────────

// A conversation is explicitly project-owned. The composite id/project key
// lets child records enforce that they cannot point at another project's row.
model Conversation {
  id            String           @id @default(cuid())
  projectId     String
  type          ConversationType
  slug          String?
  title         String?
  createdById   String?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  threads       Thread[]

  @@unique([id, projectId])
  @@unique([projectId, slug])
  @@index([projectId, type, updatedAt])
}

// Human participants use userId. systemIdentity is a deliberately small,
// migratable bridge for M6 system employees (for example chief-of-staff).
model ConversationParticipant {
  id             String       @id @default(cuid())
  projectId      String
  conversationId String
  userId         String?
  systemIdentity String?
  employeeProjectAssignmentId String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeProjectAssignment EmployeeProjectAssignment? @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, systemIdentity])
  @@index([projectId, userId])
  @@index([projectId, employeeProjectAssignmentId])
}

model Message {
  id                   String    @id @default(cuid())
  projectId            String
  conversationId       String
  threadId             String?
  authorUserId         String?
  authorSystemIdentity String?
  body                 String    @db.Text
  kind                 String    @default("MESSAGE")
  editedAt             DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation         Conversation @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  author               User?     @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  thread               Thread?   @relation("ThreadReplies", fields: [threadId, projectId], references: [id, projectId], onDelete: Cascade)
  rootForThread        Thread?   @relation("ThreadRootMessage")

  @@unique([id, projectId, conversationId])
  @@index([projectId, conversationId, createdAt])
  @@index([projectId, threadId, createdAt])
}

model Thread {
  id            String       @id @default(cuid())
  projectId     String
  conversationId String
  rootMessageId String
  title         String?
  status        ThreadStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation  Conversation @relation(fields: [conversationId, projectId], references: [id, projectId], onDelete: Cascade)
  rootMessage   Message      @relation("ThreadRootMessage", fields: [rootMessageId, projectId, conversationId], references: [id, projectId, conversationId], onDelete: Restrict)
  replies       Message[]    @relation("ThreadReplies")
  relatedTasks  Task[]       @relation("TaskThread")

  @@unique([id, projectId])
  @@unique([projectId, rootMessageId])
  @@unique([rootMessageId, projectId, conversationId])
  @@index([projectId, conversationId, status])
}

// ─── RogerOS Tasks 2.0 ─────────────────────────────────────────

// Task is the authoritative RogerOS work record. HermesTask remains a
// separate execution adapter and is deliberately not used as this model.
model Task {
  id                   String       @id @default(cuid())
  projectId            String
  parentTaskId         String?
  relatedThreadId      String?
  title                String
  description          String?      @db.Text
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  createdById          String
  dueAt                DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  resultSummary        String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask           Task?        @relation("TaskHierarchy", fields: [parentTaskId, projectId], references: [id, projectId], onDelete: Restrict)
  subtasks             Task[]       @relation("TaskHierarchy")
  relatedThread        Thread?      @relation("TaskThread", fields: [relatedThreadId, projectId], references: [id, projectId], onDelete: Restrict)
  assignments          TaskAssignment[]
  activities           TaskActivity[]
  dependencies         TaskDependency[] @relation("TaskDependencies")
  dependedOnBy         TaskDependency[] @relation("TaskDependents")

  @@unique([id, projectId])
  @@index([projectId, status, updatedAt])
  @@index([projectId, parentTaskId])
}

// A human assignee is anchored to ProjectMember, ensuring the user is already
// authorized for this project. systemIdentity is the small M6-migratable path
// for future system/employee assignment.
model TaskAssignment {
  id              String        @id @default(cuid())
  projectId       String
  taskId          String
  projectMemberId String?
  systemIdentity  String?
  employeeProjectAssignmentId String?
  createdAt       DateTime      @default(now())
  task            Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember   ProjectMember? @relation(fields: [projectMemberId, projectId], references: [id, projectId], onDelete: Cascade)
  employeeProjectAssignment EmployeeProjectAssignment? @relation(fields: [employeeProjectAssignmentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([taskId, projectMemberId])
  @@unique([taskId, systemIdentity])
  @@index([projectId, projectMemberId])
  @@unique([taskId, employeeProjectAssignmentId])
  @@index([projectId, employeeProjectAssignmentId])
}

model Employee {
  id String @id @default(cuid())
  systemKey String? @unique
  name String
  role String
  description String? @db.Text
  soulSummary String? @db.Text
  type EmployeeType @default(CUSTOM)
  status EmployeeStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectAssignments EmployeeProjectAssignment[]
}

model EmployeeProjectAssignment {
  id String @id @default(cuid())
  employeeId String
  projectId String
  status EmployeeStatus @default(ACTIVE)
  roleOverride String?
  joinedAt DateTime @default(now())
  pausedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  conversationParticipants ConversationParticipant[]
  taskAssignments TaskAssignment[]
  @@unique([employeeId,projectId])
  @@unique([id,projectId])
  @@index([projectId,status])
}

model TaskDependency {
  id               String   @id @default(cuid())
  projectId        String
  taskId           String
  dependsOnTaskId  String
  createdAt        DateTime @default(now())
  task             Task     @relation("TaskDependencies", fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  dependsOnTask    Task     @relation("TaskDependents", fields: [dependsOnTaskId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([projectId, dependsOnTaskId])
}

model TaskActivity {
  id          String           @id @default(cuid())
  projectId   String
  taskId      String
  actorUserId String?
  type        TaskActivityType
  detail      String?          @db.Text
  createdAt   DateTime         @default(now())
  task        Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  actor       User?            @relation("TaskActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, taskId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?

  // Content intelligence fields
  source          String? // "sage" | "organic" | "csv_import"
  engagementScore Float? // time-weighted composite score (updated by scoring engine)
  engagementTier  String? // "top20" | "bottom20" | null (cleared/set on rescore)

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json
}

model YoutubeIdea {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  angle            String?
  hookType         String?
  funnelStage      String?
  status           String   @default("pending")
  rejectedReason   String?
  sourceUrl        String?
  sourceSummary    String?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime @default(now())

  @@index([status])
}

model YoutubeScript {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  storySetup       String?
  conflict         String?
  insight          String?
  cta              String?
  caption          String?
  onScreenText     String?
  hookType         String?
  funnelStage      String?
  factCheck        Json?
  fullScript       String?
  status           String   @default("draft")
  rejectedReason   String?
  // SEO Package
  seoTitle         String?
  seoDescription   String?
  seoTags          Json?
  seoChapters      Json?
  titleVariants    Json?
  thumbnailConcept String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())
}

model LongformScript {
  id               String    @id @default(cuid())
  title            String
  type             String?
  status           String    @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Project-owned replacement for the legacy global DataStore. Legacy callers
// remain on DataStore until their respective isolation milestone.
model ProjectDataStore {
  id        String   @id @default(cuid())
  projectId String
  namespace String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, namespace, key])
  @@index([projectId, namespace])
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String    @db.Text
  status      String    @default("pending") // pending, active, completed, failed
  priority    String    @default("medium") // high, medium, low
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// ─── Articles ───────────────────────────────────────────────────

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String    @db.Text
  track           String // "mega-viral" | "local-viral" | "icp-viral"
  status          String    @default("idea") // "idea" | "draft" | "ready" | "posted"
  qtTweet         String?   @db.Text
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?   @db.Text
  inspirationUrls String?   @db.Text // JSON array of URLs
  themes          String? // JSON array of themes
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String? // JSON array
  createdAt DateTime @default(now())

  @@index([track])
}

// ─── Client Pulse Telegram Bot ─────────────────────────────────

model ClientPulseClient {
  id                   String                @id @default(cuid())
  notionPageId         String?               @unique
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                ClientPulseChat[]
  analyses             ClientPulseAnalysis[]
  alerts               ClientPulseAlert[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  messages        ClientPulseMessage[]
  alerts          ClientPulseAlert[]

  @@index([linkedClientId])
  @@index([status])
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String           @db.Text
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?           @db.Text
  llmSummary          String?           @db.Text
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String             @db.Text
  recommendedAction String?            @db.Text
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  client            ClientPulseClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String       @id @default(cuid())
  projectId     String
  origin        String       @default("web") // "web" | "hermes"
  kind          String       @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  sideEffecting Boolean      @default(false)
  status        String       @default("queued") // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events        AgentEvent[]

  @@index([projectId, status])
  @@index([createdAt])
}

model AgentEvent {
  id             String        @id @default(cuid())
  projectId      String
  agentRequestId String?
  kind           String        @default("activity") // activity | run | status | memory
  title          String
  detail         String?
  agent          String?
  level          String        @default("info") // info | up | warn | down
  meta           Json?
  createdAt      DateTime      @default(now())
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRequest   AgentRequest? @relation(fields: [agentRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([agentRequestId])
}

model HermesTask {
  id        String // Hermes external task id
  projectId String
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, board])
  @@index([projectId, status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String // wiki entry slug (relative path w/o .md)
  projectId  String
  namespace  String    @default("default")
  source     String    @default("hermes-wiki")
  path       String // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, namespace, type])
  @@index([projectId, status])
}
